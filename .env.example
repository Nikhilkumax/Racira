NEXT_PUBLIC_SITE_URL=https://racira.com
NEXT_PUBLIC_SITE_NAME=Racira

# ── Supabase (Finance domain blog + admin) ─────────────────────────────
# Create the project manually, then fill in the values below.
# Browser (anon) client — safe to expose; RLS enforced server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (bypasses RLS). NEVER expose to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# ── sieve scrape API (server-only) ─────────────────────────────────────
# One-time device login (writes SIEVE_API_KEY into .env.local, never prints it):
#   node --experimental-strip-types --no-warnings scripts/sieve-device-login.mjs
#
# The key has full account access and no scopes. Server-side only: it is read
# by src/domains/seo/lib/sieve/config.server.ts in route handlers, and must
# never reach the browser bundle, a NEXT_PUBLIC_ variable, a log, an error
# report, or git. Leave empty to keep sieve disabled (that is the default and
# changes nothing else in the app).
SIEVE_API_KEY=
# Optional: only set this to point the integration at a deliberate override.
# SIEVE_API_BASE_URL=https://scrape.usesieve.com
