    'IdealWeightCalculatorForWomen.tsx',
];

for (const file of polishFiles) {
    const filePath = path.join(COMPONENTS_DIR, file);
    if (!fs.existsSync(filePath)) {
        console.log('NOT FOUND: ' + file);
        continue;
    }
    const content = fs.readFileSync(filePath, 'utf8');

    // Find all <button ...>...</button> blocks (multiline)
    const buttonRegex = /<button[\s\S]*?<\/button>/g;
    let match;
    let found = false;
    while ((match = buttonRegex.exec(content)) !== null) {
        const block = match[0];
        // Extract text content between > and </button>
        const textMatch = block.match(/>([\s\S]*?)<\/button>/);
        const text = textMatch ? textMatch[1].trim() : '(no text)';
        // Skip reset buttons (icon-only, short text)
        if (text.length > 0 && text.length < 50) {
            console.log(file + ' => BUTTON TEXT: "' + text + '"');
            found = true;
        }
    }
    if (!found) {
        console.log(file + ' => NO TEXT BUTTON FOUND');
    }
}