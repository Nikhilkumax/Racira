"use client";
import React, { useState } from "react";
import { PuzzleWrapper, GameButton, range } from "./_shared";

const PUZZLE = {
    cages: [
        { cells: [[0, 0], [0, 1]], sum: 3 },
        { cells: [[0, 2], [1, 2]], sum: 4 },
        { cells: [[0, 3], [1, 3]], sum: 10 },
        { cells: [[1, 0], [2, 0]], sum: 7 },
        { cells: [[1, 1], [2, 1]], sum: 5 },
        { cells: [[2, 2], [2, 3]], sum: 9 },
        { cells: [[3, 0], [3, 1]], sum: 8 },
        { cells: [[3, 2], [3, 3]], sum: 7 },
    ],
};

export default function KillerSudokuGame() {
    const [board, setBoard] = useState < number[][] > (() => range(4).map(() => range(4).map(() => 0)));
    const [selected, setSelected] = useState < [number, number] | null > (null);

    const place = (n: number) => {
        if (!selected) return;
        const [r, c] = selected;
        const next = board.map((row) => [...row]);
        next[r][c] = n;
        setBoard(next);
    };

    const cageSums = PUZZLE.cages.map((cage) => {
        const sum = cage.cells.reduce((s, [r, c]) => s + (board[r][c] || 0), 0);
        return { ...cage, current: sum };
    });

    return (
        <PuzzleWrapper title="Killer Sudoku" subcategory="Number Puzzles" subcategorySlug="number-puzzles"
            instructions="Fill the 4×4 grid. Each row, column, and 2×2 box has 1-4. Cages (dotted) must sum to the target."
            onReset={() => { setBoard(range(4).map(() => range(4).map(() => 0))); setSelected(null); }}
            status={[{ label: "Selected", value: selected ? `${selected[0]},${selected[1]}` : "—" }]}>
            <div className="flex flex-col items-center gap-4">
                <div className="grid grid-cols-2 gap-1">
                    {cageSums.map((cage, i) => (
                        <div key={i} className="border-2 border-dashed border-primary/40 rounded p-2">
                            <div className="text-xs text-primary font-bold mb-1">Sum: {cage.sum} (now: {cage.current})</div>
                            <div className="grid grid-cols-2 gap-0.5">
                                {cage.cells.map(([r, c]) => (
                                    <button key={`${r}-${c}`} onClick={() => setSelected([r, c])}
                                        className={`w-12 h-12 flex items-center justify-center font-bold border ${selected && selected[0] === r && selected[1] === c ? "bg-primary/30" : "bg-card"}`}>
                                        {board[r][c] || ""}
                                    </button>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
                <div className="flex gap-2">
                    {[1, 2, 3, 4].map((n) => <GameButton key={n} onClick={() => place(n)}>{n}</GameButton>)}
                    <GameButton onClick={() => place(0)} variant="ghost">Clear</GameButton>
                </div>
            </div>
        </PuzzleWrapper>
    );
}