<UserControl x:Class="Calculator.CustodialAccountGrowthCalculator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10">
            <TextBlock Text="Initial Contribution ($)"/>
            <TextBox x:Name="txtInitial" Text="5000" Width="100"/>
            <TextBlock Text="Monthly Contribution ($)"/>
            <TextBox x:Name="txtMonthly" Text="200" Width="100"/>
            <TextBlock Text="Annual Return (%)"/>
            <TextBox x:Name="txtAnnualReturn" Text="7" Width="100"/>
            <TextBlock Text="Years"/>
            <TextBox x:Name="txtYears" Text="18" Width="100"/>
            <Button Content="Calculate" Click="Calculate_Click" Margin="0,10,0,0" Width="100"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="10">
            <Viewbox>
                <Canvas Width="400" Height="200">
                    <!-- Axes -->
                    <Line X1="20" Y1="180" X2="20" Y2="20" Stroke="Black" StrokeThickness="1"/>
                    <Line X1="20" Y1="180" X2="380" Y2="180" Stroke="Black" StrokeThickness="1"/>

                    <!-- Chart line: placeholder for growth -->
                    <Polyline Points="20,180 380,20" Stroke="Blue" StrokeWidth="2" Fill="None"/>
                </Canvas>
            </Viewbox>
        </Border>
    </Grid>
</UserControl>