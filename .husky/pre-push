cross-env NODE_OPTIONS=--max-old-space-size=6144 npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Type-check failed — push blocked."
  echo "   Fix type errors above before pushing."
  echo ""
  exit 1
fi

npx tsx scratch/dispatcher-coverage-check.ts
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Dispatcher coverage check failed — push blocked."
  echo "   Every live slug must have a working case in processFiles."
  echo ""
  exit 1
fi

# CAD registry reconciliation (static: live/soon split vs wired components).
node _scripts/cad-reconcile.mjs
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ CAD registry reconciliation failed — push blocked."
  echo "   A live flag is only truthful if the slug has a wired component."
  echo ""
  exit 1
fi

# Writing registry reconciliation (static: live/soon split vs the per-tool
# component map, plus SEO coverage and duplicate-component detection).
node _scripts/writing-reconcile.mjs
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Writing registry reconciliation failed — push blocked."
  echo "   A live flag is only truthful if the slug has a wired component."
  echo ""
  exit 1
fi

# Writing authored SEO contract (word band, verbatim keywords, unique FAQs,
# sibling links, similarity ceiling) — same shape as the audio/typography gates.
node scripts/validate-writing-seo.mjs
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Writing SEO validation failed — push blocked."
  echo "   Fix the authored content in src/domains/writing/registry/seo/."
  echo ""
  exit 1
fi

# Writing JSON-source pipeline: schema/structure of each authored JSON batch,
# the generated-vs-integrated drift gate, and the rendered-DOM contract (FAQ
# collapsed, related row picks, no emphasis, verbatim privacy block).
node scripts/validate-writing-seo-json.mjs
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Writing SEO JSON schema failed — push blocked."
  echo "   Fix the JSON source under src/domains/writing/registry/seo/source/."
  echo ""
  exit 1
fi

node scripts/writing-seo-drift-check.mjs
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Writing SEO drift check failed — push blocked."
  echo "   Re-run scripts/apply-writing-seo-batch.mjs --write for the listed source(s)."
  echo ""
  exit 1
fi

node scripts/validate-writing-seo-render.mjs
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Writing SEO render contract failed — push blocked."
  echo "   Fix the JSON source and regenerate; never patch the generated module."
  echo ""
  exit 1
fi

# CSS Grid min-width:auto trap guard — cheap static scan for multi-column
# grids holding unwrapped table/pre content without min-w-0 protection.
# (The full multi-viewport visual sweep below is intentionally NOT in
# pre-push — see .github/workflows/visual-qa.yml.)
node _scripts/grid-min-w0-check.mjs
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Unprotected grid layout found — push blocked."
  echo "   Multi-column grids holding tables/pre blocks need min-w-0 protection."
  echo ""
  exit 1
fi

# AdSense site-verification artifact — /public/ads.txt is the only thing
# proving this domain to Google, and nothing in the app or the type system
# changes if it is deleted or reformatted. Same check runs in CI
# (.github/workflows/visual-qa.yml).
node _scripts/adsense-verify-check.mjs
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ AdSense verification artifact broken — push blocked."
  echo "   /public/ads.txt must exist and hold the exact expected record."
  echo ""
  exit 1
fi

# AdSense served-response e2e — the static guard proves the file on disk, this
# proves GET /ads.txt actually answers 200 with the exact bytes and no
# redirect, and that robots.txt leaves the AdSense crawler alone. Reuses a
# running dev server on :3002 when one is up.
npx playwright test e2e/adsense-verification.test.ts
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ AdSense served-response e2e failed — push blocked."
  echo "   GET /ads.txt must return 200 with the exact record and no redirect."
  echo ""
  exit 1
fi

# Audio SEO rendered-DOM contract — the FAQ accordion must load collapsed, the
# related row must carry four live non-self picks, body copy must be plain
# (no bold/emphasis), the privacy block must be the verbatim shared text, and
# content must sit in the 500-1000 word band. Renders the real components, so it
# covers every authored tool automatically.
node scripts/validate-audio-seo-render.mjs
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Audio SEO render contract failed — push blocked."
  echo "   Fix the JSON source and regenerate; never patch the generated module."
  echo ""
  exit 1
fi
